{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.3",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "prebuild:android:clean": "APP_ENV=prod expo prebuild --platform android --clean && ./scripts/restore-android-keystore.sh"
  },
  "overrides": {
    "expo-mlkit-ocr": {
      "react-native": "0.81.4"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/barcode-scanning"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-ml-kit/barcode-scanning": "^2.0.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "expo": "^54.0.33",
    "expo-asset": "^12.0.9",
    "expo-build-properties": "~1.0.9",
    "expo-camera": "~17.0.8",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.8",
    "expo-crypto": "~15.0.7",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.8",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-intent-launcher": "~13.0.7",
    "expo-linking": "~8.0.8",
    "expo-local-authentication": "~17.0.7",
    "expo-mlkit-ocr": "^2.0.1",
    "expo-network": "~6.0.1",
    "expo-router": "~6.0.13",
    "expo-screen-capture": "~8.0.8",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.8",
