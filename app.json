{
  "expo": {
    "name": "Datira",
    "slug": "data-capture-app",
    "scheme": "datacapture",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/datira-icon-192.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ureondigital.datira"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/datira-icon-512.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.ureondigital.datira"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/datira-splash-512.png",
          "resizeMode": "contain",
          "imageWidth": 313,
          "ios": {
            "backgroundColor": "#000000",
            "image": "./assets/datira-splash-512.png",
            "resizeMode": "contain",
            "imageWidth": 313
          },
          "android": {
            "backgroundColor": "#F8FAFC",
            "image": "./assets/datira-splash-725.png",
            "resizeMode": "contain"
          }
        }
      ]
    ]
  }
}
